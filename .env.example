# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ggresume
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ggresume
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Authentication
AUTH_SECRET=ggresume-super-secret-auth-key-change-in-production
AUTH_LOCAL_MODE=true
NEXT_PUBLIC_AUTH_LOCAL_MODE=true

# Google OAuth 2.0 (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Resend API (used for verification emails when AUTH_LOCAL_MODE=false)
RESEND_API_KEY=re_123456789
EMAIL_FROM="GGResume <noreply@ggresume.washiul.com>"
APP_URL=http://localhost:3000

# Server / App
PORT=3000
NODE_ENV=development
