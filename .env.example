# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ggresume
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ggresume
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Authentication & Local Mode
# When AUTH_LOCAL_MODE=true:
# 1. Email verification is skipped (sign-up immediately logs in).
# 2. "Login with Google" option is hidden.
AUTH_LOCAL_MODE=true
NEXT_PUBLIC_AUTH_LOCAL_MODE=true
AUTH_SECRET=ggresume-super-secret-auth-key-change-in-production

# Server / App
PORT=3000
NODE_ENV=development
